// Properties window, modelled on Explorer's General tab: name, type, location, sizes, contents,
// dates, and the Read-only / Hidden attributes. Edits are staged: OK and Apply commit them.
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { DialogButton, HDivider, TextField } from "controls.slint";
import { FileIcon } from "fileviews.slint";

/// Filled by the app. Empty strings hide their row.
export struct PropsData {
    /// Items described; 0 means still loading.
    count: int,
    name: string,
    kind: int,
    thumb: image,
    has-thumb: bool,
    is-dir: bool,
    type-name: string,
    opens-with: string,
    location: string,
    size: string,
    size-on-disk: string,
    contains: string,
    created: string,
    modified: string,
    accessed: string,
}

component Line inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    Text { width: 112px; text: label; color: Theme.text-secondary; }
    Text { text: value; color: Theme.text-primary; wrap: word-wrap; horizontal-stretch: 1; }
}

/// Checkbox with a mixed state, as Explorer shows when selected items differ.
/// state: 0 unchecked, 1 checked, 2 mixed. Clicking a mixed box checks it.
component TriCheck inherits Rectangle {
    in property <string> text;
    in property <int> state;
    in property <bool> enabled: true;
    callback toggled(int);
    height: 28px;
    opacity: enabled ? 1 : 0.4;
    accessible-role: checkbox;
    accessible-label: text;
    accessible-checked: state == 1;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { toggled(state == 1 ? 0 : 1); } }
    forward-focus: fs;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - 20px) / 2;
            border-radius: Theme.radius;
            border-width: state == 0 ? 1px : 0px;
            border-color: Theme.text-secondary;
            background: state == 0 ? Theme.control : Theme.accent;
            if state == 1: Image { source: Icons.check; width: 14px; height: 14px; colorize: Theme.on-accent; accessible-role: none; }
            if state == 2: Rectangle { width: 10px; height: 2px; border-radius: 1px; background: Theme.on-accent; }
        }
        Text { text: root.text; color: Theme.text-primary; vertical-alignment: center; }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == " " { root.toggled(root.state == 1 ? 0 : 1); return accept; }
            reject
        }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { fs.focus(); root.toggled(root.state == 1 ? 0 : 1); }
    }
    if fs.has-focus: Rectangle {
        x: -4px;
        width: parent.width + 8px;
        border-radius: Theme.radius;
        border-width: 2px;
        border-color: Theme.text-primary;
    }
}

export component PropertiesWindow inherits Window {
    title: "Properties";
    icon: Icons.info;
    no-frame: true;
    background: transparent;
    default-font-family: "Inter";
    default-font-size: Theme.font-body;
    width: 440px;
    height: 600px;

    in property <PropsData> data;
    /// Staged edits; reset by the app each time new data arrives.
    in-out property <string> name-text;
    in-out property <int> readonly;
    in-out property <int> hidden;
    /// False for the open folder and search results: name and attributes are read-only there.
    in property <bool> can-edit: true;
    /// Edits wait for the first data, so they never apply to the previous item.
    property <bool> editable: can-edit && data.count > 0;
    in-out property <bool> dirty;
    callback apply(string, int, int);
    callback close-requested();
    public function focus-window() { esc.focus(); }

    esc := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { root.close-requested(); return accept; }
            reject
        }
    }
    Rectangle {
        background: Theme.mica;
        border-radius: Theme.radius-overlay;
        border-width: 1px;
        border-color: Theme.stroke-window;
        clip: true;
        VerticalLayout {
            // Title bar
            Rectangle {
                height: 44px;
                WindowMoveArea { }
                HorizontalLayout {
                    padding-left: 16px;
                    spacing: 12px;
                    Image { source: Icons.info; width: 16px; height: 16px; y: (parent.height - 16px) / 2; colorize: Theme.text-primary; accessible-role: none; }
                    Text {
                        text: data.count == 1 ? data.name + " Properties" : "Properties";
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 46px;
                        background: ct.has-hover ? #c42b1c : transparent;
                        accessible-role: button;
                        accessible-label: "Close";
                        accessible-action-default => { root.close-requested(); }
                        Image { source: Icons.dismiss; width: 16px; height: 16px; colorize: ct.has-hover ? #ffffff : Theme.text-primary; accessible-role: none; }
                        ct := TouchArea { clicked => { root.close-requested(); } }
                    }
                }
            }
            // Tab strip: General only for now.
            HorizontalLayout {
                height: 40px;
                padding-left: 12px;
                alignment: start;
                accessible-role: tab-list;
                Rectangle {
                    width: tab-label.preferred-width + 24px;
                    accessible-role: tab;
                    accessible-label: "General";
                    accessible-item-selected: true;
                    tab-label := Text { text: "General"; color: Theme.text-primary; font-weight: 600; vertical-alignment: center; }
                    Rectangle { y: parent.height - 3px; width: 16px; height: 3px; border-radius: 1.5px; background: Theme.accent; }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                background: Theme.layer;
                border-width: 1px;
                border-color: Theme.stroke;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 16px;
                        FileIcon {
                            size: 48px;
                            kind: data.count == 1 ? data.kind : 1;
                            thumb: data.thumb;
                            has-thumb: data.has-thumb && data.count == 1;
                        }
                        if data.count == 1 && root.can-edit: TextField {
                            y: (parent.height - self.height) / 2;
                            // A long name must scroll inside the field, not widen the window content.
                            min-width: 0px;
                            preferred-width: 100px;
                            horizontal-stretch: 1;
                            clip: true;
                            placeholder: "Name";
                            text <=> root.name-text;
                            edited => { root.dirty = true; }
                            accepted => {
                                if root.dirty { root.apply(root.name-text, root.readonly, root.hidden); }
                                root.close-requested();
                            }
                        }
                        if data.count != 1 || !root.can-edit: Text {
                            text: data.count == 1 ? data.name : data.count > 1 ? data.count + " items" : "Reading...";
                            color: Theme.text-primary;
                            font-size: Theme.font-subtitle;
                            font-weight: 600;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                    HDivider { }
                    if data.type-name != "": Line { label: data.is-dir || data.count != 1 ? "Type:" : "Type of file:"; value: data.type-name; }
                    if data.opens-with != "": Line { label: "Opens with:"; value: data.opens-with; }
                    HDivider { }
                    if data.location != "": Line { label: "Location:"; value: data.location; }
                    if data.size != "": Line { label: "Size:"; value: data.size; }
                    if data.size-on-disk != "": Line { label: "Size on disk:"; value: data.size-on-disk; }
                    if data.contains != "": Line { label: "Contains:"; value: data.contains; }
                    if data.created != "" || data.modified != "" || data.accessed != "": HDivider { }
                    if data.created != "": Line { label: "Created:"; value: data.created; }
                    if data.modified != "": Line { label: "Modified:"; value: data.modified; }
                    if data.accessed != "": Line { label: "Accessed:"; value: data.accessed; }
                    HDivider { }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { width: 112px; text: "Attributes:"; color: Theme.text-secondary; vertical-alignment: center; }
                        TriCheck {
                            text: "Read-only";
                            state: root.readonly;
                            enabled: root.editable;
                            toggled(s) => { root.readonly = s; root.dirty = true; }
                        }
                        TriCheck {
                            text: "Hidden";
                            state: root.hidden;
                            enabled: root.editable;
                            toggled(s) => { root.hidden = s; root.dirty = true; }
                        }
                    }
                }
            }
            HorizontalLayout {
                padding: 12px;
                spacing: 8px;
                alignment: end;
                DialogButton {
                    text: "OK";
                    primary: true;
                    clicked => {
                        if root.dirty && root.editable { root.apply(root.name-text, root.readonly, root.hidden); }
                        root.close-requested();
                    }
                }
                DialogButton { text: "Cancel"; clicked => { root.close-requested(); } }
                DialogButton {
                    text: "Apply";
                    opacity: root.dirty && root.editable ? 1 : 0.4;
                    clicked => { if root.dirty && root.editable { root.apply(root.name-text, root.readonly, root.hidden); } }
                }
            }
        }
    }
}
