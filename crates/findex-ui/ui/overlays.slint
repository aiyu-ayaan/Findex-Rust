// Transfer panel, dialogs and toast.
import { Theme } from "theme.slint";
import { DialogButton, SnappedText, TextField } from "controls.slint";

/// Modal dialog: smoke layer, 480 px max, 24 px padding, one primary action. Escape cancels.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> primary-text: "OK";
    in property <bool> danger;
    in property <bool> has-input;
    in property <string> input-label;
    in-out property <string> input-text;
    callback primary();
    callback dismiss();
    background: Theme.smoke;

    public function open-focus() {
        if has-input { field.focus-input(); field.select-all(); } else { cancel-btn.focus(); }
    }

    TouchArea { }
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.dismiss(); return accept; }
            reject
        }
        Rectangle {
            width: min(480px, root.width - 48px);
            height: body.preferred-height;
            background: Theme.dialog;
            border-radius: Theme.radius-overlay;
            border-width: 1px;
            border-color: Theme.stroke-strong;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            accessible-role: groupbox;
            accessible-label: title;
            body := VerticalLayout {
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: title; color: Theme.text-primary; font-size: Theme.font-subtitle; font-weight: 600; wrap: word-wrap; }
                    if message != "": Text { text: message; color: Theme.text-primary; wrap: word-wrap; }
                    if has-input: Text { text: input-label; color: Theme.text-secondary; font-size: Theme.font-caption; }
                    field := TextField {
                        visible: has-input;
                        height: has-input ? 32px : 0px;
                        text <=> root.input-text;
                        placeholder: input-label;
                        accepted => { root.primary(); }
                        escape => { root.dismiss(); }
                    }
                }
                Rectangle {
                    background: Theme.dark ? #202020 : #f3f3f3;
                    border-bottom-left-radius: Theme.radius-overlay;
                    border-bottom-right-radius: Theme.radius-overlay;
                    HorizontalLayout {
                        padding: 24px;
                        spacing: 8px;
                        alignment: end;
                        DialogButton { text: primary-text; primary: true; danger: root.danger; clicked => { root.primary(); } }
                        cancel-btn := DialogButton { text: "Cancel"; clicked => { root.dismiss(); } }
                    }
                }
            }
        }
    }
}

/// Toast: bottom centre, polite, never takes focus.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> can-undo;
    callback undo();
    width: row.preferred-width;
    height: 40px;
    border-radius: Theme.radius-overlay;
    background: Theme.acrylic;
    border-width: 1px;
    border-color: Theme.stroke-strong;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;
    accessible-role: AccessibleRole.text;
    accessible-label: text;
    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 12px;
        Text { text: root.text; color: Theme.text-primary; vertical-alignment: center; }
        if can-undo: Rectangle {
            width: 64px;
            height: 28px;
            y: 6px;
            border-radius: Theme.radius;
            background: u.pressed ? Theme.subtle-pressed : u.has-hover ? Theme.subtle-hover : transparent;
            accessible-role: button;
            accessible-label: "Undo";
            accessible-action-default => { root.undo(); }
            SnappedText {
                width: parent.width;
                height: parent.height;
                text: "Undo";
                color: Theme.accent;
            }
            u := TouchArea { clicked => { root.undo(); } }
        }
    }
}
